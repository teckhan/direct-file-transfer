        "@vueuse/core": "^14.3.0",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "internal-ip": "^9.0.0",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "vue": "^3.5.39",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.2",
