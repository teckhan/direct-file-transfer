{
    "identifier": "main",
    "description": "Capability for the main window",
    "local": true,
    "windows": ["main"],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "fs:allow-create",
        "fs:allow-read-dir",
        "fs:allow-rename",
        "fs:allow-write",
        "fs:allow-write-file",
        "core:app:default",
        "dialog:allow-ask",
        "dialog:allow-confirm",
        "dialog:allow-message",
        "dialog:allow-open",
        "dialog:allow-save",
        "core:resources:default",
        "core:menu:default",
        "core:tray:default",
        "core:webview:allow-internal-toggle-devtools",
        "core:webview:default"
    ],
    "platforms": ["linux", "macOS", "windows", "android", "iOS"]
}
